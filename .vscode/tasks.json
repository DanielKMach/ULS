{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build-lsp",
			"type": "shell",
			"command": [
				"zig",
				"build"
			]
		},
		{
			"label": "copy-bin",
			"type": "shell",
			"command": [
				"cp",
				"./zig-out/bin/*.exe",
				"./out/bin/"
			],
			"dependsOn": [
				"build-lsp"
			]
		},
		{
			"label": "compile-client",
			"type": "npm",
			"script": "compile",
			"group": "build",
			"dependsOn": [
				"copy-bin"
			],
			"presentation": {
				"panel": "dedicated",
				"reveal": "never"
			},
			"problemMatcher": [
				"$tsc"
			]
		},
		{
			"label": "watch-client",
			"type": "npm",
			"script": "watch",
			"isBackground": true,
			"dependsOn": [
				"copy-bin"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"panel": "dedicated",
				"reveal": "never"
			},
			"problemMatcher": [
				"$tsc-watch"
			]
		}
	]
}