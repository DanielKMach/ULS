{
	"name": "usrl",
	"displayName": "USRL",
	"description": "USRL support for Visual Studio Code",
	"icon": "static/icon.png",
	"version": "1.0.1",
	"publisher": "danielkmach",
	"author": "Daniel Koucher Machado",
	"license": "MIT",
	"repository": {
		"url": "https://github.com/DanielKMach/ULS"
	},
	"categories": [ "Programming Languages", "Snippets" ],
	"keywords": [
		"multi-root ready"
	],
	"engines": {
		"vscode": "^1.100.0"
	},
	"main": "./dist/extension",
	"contributes": {
		"languages": [
			{
				"id": "usrl",
				"aliases": [
					"USRL"
				],
				"extensions": [
					".usrl"
				],
				"icon": {
					"light": "static/icon.svg",
					"dark": "static/icon.svg"
				},
				"configuration": "static/usrl-language-configuration.json"
			}
		],
		"snippets": [
			{
				"language": "usrl",
				"path": "static/snippets.json"
			}
		],
		"grammars": [
			{
				"language": "usrl",
				"scopeName": "source.usrl",
				"path": "static/usrl.tmLanguage.json"
			}
		],
		"configuration": {
			"id": "usrl",
			"type": "object",
			"title": "USRL",
			"properties": {
				"usrl.preferredExecutable": {
					"type": "string",
					"description": "The executable to be used when running a query. Defaults to `usrl` when empty.",
					"default": "usrl"
				}
			}
		},
		"commands": [
			{
				"command": "usrl.openManual",
				"title": "USRL: Open Manual",
				"shortTitle": "Open Manual"
			},
			{
				"command": "usrl.restartLanguageServer",
				"title": "USRL: Restart Language Server",
				"shortTitle": "Restart Language Server"
			}
		]
	},
	"scripts": {
		"watch": "tsc --noEmit --watch",
		"build": "zig build && tsc -b && node esbuild.js",
		"build:prod": "zig build -Dall --release=small && tsc -b && node esbuild.js --production",
		"package": "npm run build:prod && vsce package"
	},
	"dependencies": {
		"glob": "^11.0.0",
		"vscode-languageclient": "^9.0.1"
	},
	"devDependencies": {
		"@types/node": "^22",
		"@types/vscode": "^1.100.0",
		"@vscode/vsce": "^3.9.1",
		"esbuild": "^0.28.0",
		"typescript": "^5.9.2"
	}
}
