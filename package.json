{
	"name": "usrl-language-server",
	"description": "The official USRL language server",
	"version": "0.1.0",
	"author": "DanielKMach",
	"publisher": "danielkmach",
	"license": "MIT",
	"categories": [],
	"keywords": [
		"multi-root ready"
	],
	"engines": {
		"vscode": "^1.100.0"
	},
	"activationEvents": [
		"onLanguage:plaintext"
	],
	"main": "./out/extension",
	"contributes": {
		"configuration": {
			"type": "object",
			"title": "USRL LSP Configuration",
			"properties": {}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -b",
		"watch": "tsc -b -w",
		"lint": "eslint",
		"postinstall": "cd client && npm install && cd ../server && npm install && cd ..",
		"test": "powershell ./scripts/e2e.ps1"
	},
	"dependencies": {
		"glob": "^11.0.0",
		"vscode-languageclient": "^9.0.1"
	},
	"devDependencies": {
		"@types/vscode": "^1.100.0",
		"@vscode/test-electron": "^2.3.9",
		"mocha": "^10.3.0",
		"typescript": "^5.9.2",
		"@types/mocha": "^10.0.6",
		"@types/node": "^22"
	}
}