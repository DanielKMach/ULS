{
	"name": "usrl",
	"displayName": "USRL Language",
	"description": "The official USRL extension for Visual Studio Code",
	"icon": "./icon.png",
	"version": "0.1.0",
	"publisher": "danielkmach",
	"author": "DanielKMach",
	"license": "MIT",
	"repository": { "url": "https://github.com/DanielKMach/USRL-LSP" },
	"categories": [],
	"keywords": [ "multi-root ready" ],
	"engines": { "vscode": "^1.100.0" },
	"activationEvents": [ "onLanguage:usrl" ],
	"main": "./out/extension",
	"contributes": {
		"languages": [{
			"id": "usrl",
			"aliases": [ "USRL" ],
			"extensions": [ ".usrl" ],
			"icon": {
				"light": "./icon.svg",
				"dark": "./icon.svg"
			}
		}],
		"grammars": [{
			"language": "usrl",
			"scopeName": "source.usrl",
			"path": "./usrl.tmLanguage.json"
		}],
		"configuration": {
			"id": "usrl",
			"type": "object",
			"title": "USRL",
			"properties": {
				"usrl.preferredExecutable": {
					"type": "string",
					"description": "The executable to be used when running a query. Defaults to `usrl` when empty.",
					"default": "usrl"
				}
			}
		},
		"commands": [
			{
				"command": "usrl.openManual",
				"title": "USRL: Open Manual",
				"shortTitle": "Open Manual"
			},
			{
				"command": "usrl.restartLanguageServer",
				"title": "USRL: Restart Language Server",
				"shortTitle": "Restart Language Server"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -b",
		"watch": "tsc -b -w",
		"lint": "eslint",
		"postinstall": "cd client && npm install && cd ../server && npm install && cd ..",
		"test": "powershell ./scripts/e2e.ps1"
	},
	"dependencies": {
		"glob": "^11.0.0",
		"vscode-languageclient": "^9.0.1"
	},
	"devDependencies": {
		"@types/mocha": "^10.0.6",
		"@types/node": "^22",
		"@types/vscode": "^1.100.0",
		"@vscode/test-electron": "^2.3.9",
		"js-yaml": "^4.1.1",
		"mocha": "^10.3.0",
		"typescript": "^5.9.2"
	}
}